{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TaxRate": 0.10,
  "ConnectionStrings": {
    "OrdersDb": "",
    "OrdersDbPostgres": ""
  },
  "Messaging": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    "Host": ""
  },
  "ServiceBus": {
    "EventTargets": {
      "orders.OrderPlaced": [ "inventory.order-placed" ],
      "orders.ReadyForPayment": [ "payments.ready-for-payment" ],
      "orders.OrderConfirmed": [ "notifications.order-confirmed" ],
      "orders.PaymentFailed": [ "notifications.payment-failed" ],
      "orders.RefundRequested": [ "payments.refund-requested" ],
      "orders.OrderCompleted": [ "notifications.order-completed" ],
      "orders.OrderCancelled": [ "inventory.order-cancelled", "notifications.order-cancelled" ]
    }
  },
  "Turnstile": {
    "SecretKey": ""
  }
}
