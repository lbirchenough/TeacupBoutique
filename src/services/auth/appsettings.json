{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "CommerceSpa",
    "AccessTokenExpiryMinutes": 6,
    "RefreshTokenExpiryDays": 7,
    "Key": ""
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "Messaging": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    "Host": ""
  },
  "ServiceBus": {
    "EventTargets": {
      "auth.EmailVerificationRequested": [ "notifications.email-verification" ],
      "auth.PasswordResetRequested": [ "notifications.password-reset" ],
      "auth.EmailChanged": [ "notifications.email-changed" ],
      "auth.EmailChangeVerificationRequested": [ "notifications.email-change-verification" ],
      "auth.PasswordChanged": [ "notifications.password-changed" ]
    }
  },
  "ConnectionStrings": {
    "AuthDb": "",
    "AuthDbPostgres": ""
  },
  "Turnstile": {
    "SecretKey": ""
  }
}
