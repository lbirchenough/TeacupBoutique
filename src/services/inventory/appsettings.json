{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InventoryDb": "",
    "InventoryDbPostgres": ""
  },
  "Messaging": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    "Host": ""
  },
  "ServiceBus": {
    "EventTargets": {
      "inventory.StockReserved": [ "orders.stock-reserved" ],
      "inventory.StockUnavailable": [ "orders.stock-unavailable" ],
      "inventory.BookingCancelled": [ "orders.booking-cancelled" ],
      "inventory.BookingCompleted": [ "orders.booking-completed" ],
      "inventory.ReturnAssessedWithMissingItems": [ "orders.return-assessed-missing" ]
    }
  }
}
