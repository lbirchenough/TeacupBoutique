{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
   "Routes": {
     "route1" : {
       "ClusterId": "auth-cluster",
       "Match": {
         "Path": "/api/auth/{**catch-all}"
       }
     }
   },
   "Clusters": {
     "auth-cluster": {
       "Destinations": {
         "destination1": {
           "Address": "http://localhost:5194/"
         }
       }
     }
   }
 }
}
