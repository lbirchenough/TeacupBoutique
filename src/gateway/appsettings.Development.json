{
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "CommerceSpa"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "route2-public": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "route2-admin": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },
      "route3": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "route4-admin": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/orders/admin/{**catch-all}"
        }
      },
      "route4-mine": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/orders/mine"
        }
      },
      "route4-claim": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/orders/claim",
          "Methods": [ "PATCH" ]
        }
      },
      "route4": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "route5": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "route6": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/webhooks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5194/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5035/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5079/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5127/"
          }
        }
      }
    }
  }
}
