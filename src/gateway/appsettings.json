{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "CommerceSpa",
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "ReverseProxy": {
    "Routes": {
      "route1-login": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-10-per-min",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "route1-register": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-5-per-hour",
        "Match": {
          "Path": "/api/auth/register"
        }
      },
      "route1-forgot-password": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-5-per-hour",
        "Match": {
          "Path": "/api/auth/forgot-password"
        }
      },
      "route1-reset-password": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-5-per-hour",
        "Match": {
          "Path": "/api/auth/reset-password"
        }
      },
      "route1-verify-email": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/verify-email"
        }
      },
      "route1-verify-email-change": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/verify-email-change"
        }
      },
      "route1-change-password": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "fixed-5-per-hour-user",
        "Match": {
          "Path": "/api/auth/change-password"
        }
      },
      "route1-me": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/me"
        }
      },
      "route1-profile": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "fixed-5-per-hour-user",
        "Match": {
          "Path": "/api/auth/profile"
        }
      },
      "route1-logout": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "fixed-10-per-min",
        "Match": {
          "Path": "/api/auth/logout"
        }
      },
      "route1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "route2-public": {
        "ClusterId": "inventory-cluster",
        "RateLimiterPolicy": "fixed-100-per-min",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "route2-admin": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },
      "route3": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "route3-maintenance": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/maintenance/{**catch-all}"
        }
      },
      "route3-spare-stock": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/spare-stock"
        }
      },
      "route4-create": {
        "ClusterId": "orders-cluster",
        "RateLimiterPolicy": "fixed-5-per-hour",
        "Match": {
          "Path": "/api/orders",
          "Methods": [ "POST" ]
        }
      },
      "route4-admin": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/orders/admin/{**catch-all}"
        }
      },
      "route4-mine": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/orders/mine"
        }
      },
      "route4-claim": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/orders/claim",
          "Methods": [ "PATCH" ]
        }
      },
      "route4": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "route5-create-intent": {
        "ClusterId": "payments-cluster",
        "RateLimiterPolicy": "fixed-5-per-hour",
        "Match": {
          "Path": "/payments/create-intent"
        }
      },
      "route5": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "route6": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/webhooks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://inventory:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payments:8080/"
          }
        }
      }
    }
  }
}
